{
  "name": "@wickermoney/web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WickerMoney/wicker-money.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/WickerMoney/wicker-money#readme",
  "bugs": {
    "url": "https://github.com/WickerMoney/wicker-money/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --config vite.frame.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p browser-check/hostile/tsconfig.json",
    "test": "vitest run",
    "test:browser": "cd ../api && tsx ../web/browser-check/run.ts",
    "test:hostile": "pnpm --filter @wickermoney/api exec tsx ../web/browser-check/hostile/run.ts && pnpm --filter @wickermoney/api exec tsx ../web/browser-check/hostile/remote.ts",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wickermoney/plugin-sdk": "workspace:*",
    "@wickermoney/ui-kit": "workspace:*",
    "@module-federation/runtime": "^2.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@wickermoney/plugin-forecast": "workspace:*",
    "@wickermoney/plugin-insights": "workspace:*",
    "@wickermoney/plugin-spending-trends": "workspace:*",
    "@wickermoney/plugin-upcoming": "workspace:*",
    "@module-federation/vite": "^1.23.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
