# Keeps the build context small and, more importantly, keeps host build output
# and secrets out of the image. The Dockerfile installs and builds from scratch.

# Version control and CI
.git
.github

# Never ship local secrets. `.env.example` is documentation, not build input.
.env
.env.*

# Dependencies and build output are produced inside the image. Copying a host's
# node_modules in would bring the wrong platform's native modules with it.
**/node_modules
**/dist
**/.turbo
**/coverage
**/*.tsbuildinfo

# Generated by the plugin builds and by Module Federation
apps/web/public/plugins
**/@mf-types
**/@mf-types.d.ts
**/@mf-types.zip
**/.mf

# Editor and OS noise
.DS_Store
.vscode
.idea
