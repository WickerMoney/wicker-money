{
  "$schema": "https://v2-11-4.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "../../apps/web/public/plugins/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "MIGRATION_DATABASE_URL",
        "APP_DB_PASSWORD",
        "APP_DB_ROLE",
        "AUTH_SECRET",
        "PORT",
        "HOST",
        "NODE_ENV"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "TEST_ADMIN_DATABASE_URL",
        "APP_DB_ROLE",
        "NODE_ENV"
      ]
    }
  }
}
