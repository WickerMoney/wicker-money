# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# ── Database ────────────────────────────────────────────────────────────────
# Two identities, deliberately.
#
# The API connects as wickermoney_app: a least-privilege role that is NOT a
# superuser and does NOT own the tables. This is load-bearing, not hygiene — a
# superuser bypasses row-level security unconditionally, even under FORCE ROW
# LEVEL SECURITY, so connecting as one would make every policy decorative.
DATABASE_URL=postgresql://wickermoney_app:wickermoney_app_dev_password@localhost:5432/wickermoney

# The SAME database, connected as the OWNER. This is not a "migrate from"
# source — no data is ever read from the previous application. Schema migration
# means the numbered DDL files in apps/api/src/db/migrations.
#
# The owner can create schemas, types, policies, roles and SECURITY DEFINER
# functions. The app role above deliberately cannot, because a role with those
# privileges also bypasses row-level security.
DATABASE_OWNER_URL=postgresql://wickermoney:wickermoney_dev_password@localhost:5432/wickermoney

# Migration 005 creates wickermoney_app as NOLOGIN with no password, because a
# migration file is the wrong place for a secret. `pnpm migrate` reads this and
# grants LOGIN. It must match the password in DATABASE_URL above.
APP_DB_PASSWORD=wickermoney_app_dev_password

# Name of the application role. Override only when several databases share one
# PostgreSQL server: roles are cluster-wide, so two environments using the same
# role name means whichever ran last owns the password. The test suite already
# defaults to `wickermoney_app_test` for exactly this reason.
# APP_DB_ROLE=wickermoney_app

# Connections the API may hold open to PostgreSQL (2 to 200). Each request holds
# one for the length of its transaction, so this caps concurrent database work
# in one API process. The server's max_connections must cover it for every API
# process you run, plus migrations and your own tools.
DB_POOL_MAX=10

# Longest one SQL statement may run, in MILLISECONDS (1000 to 3600000; 30 would
# be rejected, not read as seconds). A statement over the limit is cancelled and
# the request fails with a generic error; the cause is in the log.
DB_STATEMENT_TIMEOUT=30000

# The same limit, in MILLISECONDS, for the routes that legitimately run longer:
# CSV import (including waiting its turn behind another import into the same
# account) and the data export. Only those routes' transactions use it. Must
# not be lower than DB_STATEMENT_TIMEOUT.
DB_LONG_STATEMENT_TIMEOUT=300000

# The most data rows one CSV import may contain (1 to 1000000), counting rows
# that cannot be read. A larger file is refused with a message that names this
# limit. The 8 MB file size limit applies as well and is not configurable.
IMPORT_MAX_ROWS=50000

# ── Logging ─────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
#
# Worth leaving on. The API deliberately returns a generic "Something went
# wrong." for any unexpected failure and keeps the real cause — including the
# PostgreSQL error code, detail and hint — in the log. At `silent` there is no
# record of it anywhere.
LOG_LEVEL=info

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
#
# Besides signing access tokens, this secret derives the key that signs the
# per-transaction tenant context the database checks in every row-level
# security policy. `pnpm migrate`
# installs that key in the database; the API refuses to start when the database
# key does not match this value. After CHANGING this secret, run
# `pnpm --filter @wickermoney/api migrate` again before starting the API.
AUTH_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# Access tokens live at most 15 minutes. The refresh token is an HttpOnly
# cookie (`wickermoney_refresh`, SameSite=Strict, scoped to /api/v1/auth) rather
# than something scripts can read; it is rotated on every use, and presenting
# an already-used one revokes the whole session as suspected theft.

# Whether the refresh cookie carries the Secure attribute (HTTPS only).
# Defaults to true when NODE_ENV=production. Browsers refuse a Secure cookie
# over plain HTTP, so local development on http://localhost needs false.
COOKIE_SECURE=false

# Whether POST /api/v1/auth/register accepts new accounts. Set to false once
# the accounts you need exist; registration then answers 403
# `registration_disabled`. Note that while it is open, registering an address
# that already has an account answers 409 `email_taken`, which reveals that the
# address is registered. That is intentional on a self-hosted instance, and
# the per-address and per-email limits below bound probing.
REGISTRATION_ENABLED=true

# The email address that becomes the instance owner. Leave blank and the FIRST
# account to register is the owner, so on a server others can reach, whoever
# registers first owns it (and can turn plugins on and off for everyone). Set it
# and only the account registered with this address (compared without regard to
# case) can become the owner; everyone else is a member, even if they register
# first. It never creates a second owner while one exists, and never changes
# existing accounts. Email addresses are not verified at registration, so this
# does not stop someone who knows the address from registering it before you do:
# register your own account promptly, then set REGISTRATION_ENABLED=false.
BOOTSTRAP_OWNER_EMAIL=

# Set true ONLY when the API runs behind a reverse proxy you control, so the
# rate limiter sees the real client address from X-Forwarded-For. Left true
# while exposed directly, clients could spoof their address and dodge limits.
TRUST_PROXY=false

# Rate limits on register, login and refresh (429 `rate_limited`). Counters are
# in memory, so they are per API process and reset on restart.
# Requests per client address per window on each of those endpoints.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Stricter cap on login and registration attempts per email address per window,
# regardless of how many addresses they come from.
AUTH_EMAIL_RATE_LIMIT_MAX=5
# Password hashes (Argon2id, ~46 MiB each) computed at once; excess work queues.
AUTH_MAX_CONCURRENT_HASHES=4

# ── Plugins ─────────────────────────────────────────────────────────────────
# Comma-separated https origins allowed to serve plugin front-end code, for
# example https://plugins.example.com. Leave it empty: plugin code is then
# loaded from this server only. Plugin front-end code runs in the app's origin
# with the signed-in user's full access to the API, and plugin grants do not
# restrict it, so only list an origin you trust completely. Third-party plugin
# install is not supported yet.
# PLUGIN_REMOTE_ORIGINS=

# ── Web app ─────────────────────────────────────────────────────────────────
# Directory holding the built web app (apps/web/dist, with the plugin remotes
# under plugins/). When set, the API serves the UI and the plugins itself, on
# the same origin as /api, which the refresh cookie and same-origin plugin
# loading rely on. Leave it unset in development: Vite serves the UI on :5173
# and proxies /api here. The container image sets it to /app/web.
# WEB_DIST_DIR=
